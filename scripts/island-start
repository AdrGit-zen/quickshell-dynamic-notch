#!/bin/sh
# Supervise the Island Quickshell process and Hyprland layer for this login.
PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"
export PATH

uid=$(id -u)
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$uid}"
wayland_display="${WAYLAND_DISPLAY:-wayland-1}"
case "$wayland_display" in
    /*) wayland_socket="$wayland_display" ;;
    *)  wayland_socket="$runtime_dir/$wayland_display" ;;
esac
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_path="$config_home/quickshell/island/shell.qml"
log_file="$runtime_dir/island-start.log"

log() {
    printf '%s %s\n' "$(date '+%F %T')" "$*" >> "$log_file"
}

export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-Hyprland}"
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-Hyprland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland}"

for required in qs hyprctl jq; do
    if ! command -v "$required" >/dev/null 2>&1; then
        log "Required command '$required' is missing; checker cannot run."
        exit 1
    fi
done

hyprland_ready() {
    [ -S "$wayland_socket" ] || return 1
    monitors=$(hyprctl -j monitors 2>/dev/null) || return 1
    printf '%s\n' "$monitors" | jq -e 'type == "array"' >/dev/null 2>&1
}

has_active_output() {
    monitors=$(hyprctl -j monitors 2>/dev/null) || return 1
    printf '%s\n' "$monitors" | jq -e 'type == "array" and length > 0' >/dev/null 2>&1
}

island_pids() {
    qs list --all --json 2>/dev/null |
        jq -r --arg config "$config_path" '
            if type == "array" then
                .[] | select(.config_path == $config) | .pid |
                select(type == "number" and . > 0)
            else
                empty
            end
        '
}

has_island() {
    [ -n "$(island_pids)" ]
}

has_island_layer() {
    hyprctl layers 2>/dev/null | grep -Fq 'namespace: island'
}

is_fullscreen() {
    hyprctl -j activewindow 2>/dev/null |
        jq -e '(.fullscreen // 0) > 0' >/dev/null 2>&1
}

wait_for_session() {
    attempt=0
    while [ "$attempt" -lt 100 ]; do
        hyprland_ready && return 0
        attempt=$((attempt + 1))
        sleep 0.2
    done
    return 1
}

last_start=0
next_start=0
retry_delay=5

start_island() {
    now=$(date +%s)
    if [ "$now" -lt "$next_start" ]; then
        return 0
    fi

    log "Starting Island Quickshell."
    if qs --config island --no-duplicate --daemonize >> "$log_file" 2>&1; then
        last_start=$now
        next_start=$((now + retry_delay))
        if [ "$retry_delay" -lt 30 ]; then
            retry_delay=$((retry_delay * 2))
            [ "$retry_delay" -gt 30 ] && retry_delay=30
        fi
    else
        log "Quickshell launch command failed; retrying after backoff."
        next_start=$((now + retry_delay))
        if [ "$retry_delay" -lt 30 ]; then
            retry_delay=$((retry_delay * 2))
            [ "$retry_delay" -gt 30 ] && retry_delay=30
        fi
    fi
    missing_checks=0
}

restart_island() {
    pids=$(island_pids)
    if [ -n "$pids" ]; then
        log "Island layer stayed missing; restarting Island process(es): $(printf '%s' "$pids" | tr '\n' ' ')"
        for pid in $pids; do
            kill -TERM "$pid" 2>/dev/null || true
        done
        attempt=0
        while [ "$attempt" -lt 10 ] && [ -n "$(island_pids)" ]; do
            attempt=$((attempt + 1))
            sleep 1
        done
        pids=$(island_pids)
        if [ -n "$pids" ]; then
            log "Island did not exit after TERM; forcing its process(es) to close."
            for pid in $pids; do
                kill -KILL "$pid" 2>/dev/null || true
            done
            sleep 1
        fi
    fi

    last_start=0
    next_start=0
    retry_delay=5
    start_island
}

if ! wait_for_session; then
    log "Hyprland is not ready yet; exiting so systemd can retry."
    exit 1
fi

if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd WAYLAND_DISPLAY HYPRLAND_INSTANCE_SIGNATURE XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_SESSION_DESKTOP QT_QPA_PLATFORM >/dev/null 2>&1 || true
fi

if has_island; then
    log "Watching the existing Island process and Hyprland layer."
    last_start=$(date +%s)
else
    start_island
fi

missing_checks=0
session_missing_logged=0
output_missing_logged=0

while :; do
    if ! hyprland_ready; then
        if [ "$session_missing_logged" -eq 0 ]; then
            log "Hyprland connection is temporarily unavailable; waiting for it to return."
            session_missing_logged=1
        fi
        sleep 3
        continue
    fi
    session_missing_logged=0

    if ! has_island; then
        log "Island process is absent; scheduling recovery."
        start_island
        missing_checks=0
    elif ! has_active_output; then
        if [ "$output_missing_logged" -eq 0 ]; then
            log "Hyprland has no active output; keeping the watcher alive until one returns."
            output_missing_logged=1
        fi
        missing_checks=0
    else
        output_missing_logged=0
        if is_fullscreen; then
            # Island intentionally hides during fullscreen, per its QML setting.
            missing_checks=0
        elif has_island_layer; then
            missing_checks=0
            retry_delay=5
        else
            now=$(date +%s)
            elapsed=$((now - last_start))
            if [ "$elapsed" -lt 25 ]; then
                missing_checks=0
            else
                missing_checks=$((missing_checks + 1))
                if [ "$missing_checks" -eq 1 ]; then
                    log "Island process is alive but its Hyprland layer is missing; checking again before recovery."
                fi
                if [ "$missing_checks" -ge 3 ]; then
                    restart_island
                fi
            fi
        fi
    fi

    sleep 3
done
